{
  "name": "ariv-better-themes",
  "displayName": "Ariv Better Themes",
  "description": "A customized dark theme based on Ariv Themes.",
  "version": "1.0.0",
  "icon": "icon.png",
  "publisher": "shubhamsharma",
  "engines": {
    "vscode": "^1.108.0"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rhaluk/ariv-better-themes.git"
  },
  "categories": [
    "Themes"
  ],
  "extensionPack": [
    "PKief.material-icon-theme",
    "Melishev.feather-product-icons"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Ariv Better Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/ariv-better-dark-color-theme.json"
      },
      {
        "label": "Ariv Better Ocean",
        "uiTheme": "vs-dark",
        "path": "./themes/ariv-better-ocean-color-theme.json"
      }
    ]
  },
  "dependencies": {
    "@types/vscode": "^1.108.0"
  }
}